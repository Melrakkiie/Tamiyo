# Copy this file to .env and fill in the values you need. Tamiyo reads
# environment variables directly (via viper.AutomaticEnv()) — there's no
# code that loads a .env file automatically, so either export these in your
# shell, pass them to `docker compose run`/`docker compose up` (e.g. via
# `env_file: .env` in compose.yml), or set them in your deployment platform.

# --- Database ---
# When running via `docker compose up`, these are already set in
# compose.yml and don't need to be duplicated here.
# PGHOST, PGUSER, PGPASSWORD and PGDATABASE are required — the app won't
# start without them (see internal/config). PGPORT defaults to 5432.
PGHOST=localhost
PGPORT=5432
PGUSER=login
PGPASSWORD=password
PGDATABASE=tamiyo_db

# sslmode passed to Postgres (disable, require, verify-ca, verify-full...).
# disable is fine for the local Docker Compose Postgres. In production,
# against a managed/remote database, this almost always needs to be
# "require" or stricter.
PGSSLMODE=disable

# Connection pool limits, sized to stay well under what small managed
# Postgres plans allow even with a few app instances. Raise
# DB_MAX_OPEN_CONNS if you outgrow these defaults.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# --- Server ---
APP_PORT=8080

# How long the server waits for in-flight requests to finish after
# receiving SIGINT/SIGTERM (e.g. on redeploy) before forcing them closed.
SHUTDOWN_TIMEOUT_SECONDS=10

# --- JWT / sessions ---
# Required. No default — the app won't start without it. Use a long,
# random value (e.g. `openssl rand -base64 48`), never commit the real one.
JWT_SECRET=

# How long an access token (the JWT from register/login/refresh) stays
# valid before a refresh is required. Default: 15.
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# How long a refresh token stays valid before the client must log in again
# from scratch. Default: 30.
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting (/auth/register, /auth/login, /auth/forgot-password) ---
# Requests allowed per client IP, per window, shared across the three
# routes above. In-memory, per-instance (see internal/ratelimit).
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Password recovery ---
# How long a "forgot password" reset token stays valid. Default: 30.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# fmt-style template with a single %s for the token, used to build the link
# sent in the reset email, e.g.:
#   PASSWORD_RESET_URL_TEMPLATE=https://app.example.com/reset-password?token=%s
# Leave empty (default) to have the email include the raw token with
# instructions to call POST /auth/reset-password directly — there's no
# frontend to link to yet.
PASSWORD_RESET_URL_TEMPLATE=

# --- CORS (browser clients only — never affects curl/mobile/server calls) ---
# Comma-separated list of origins allowed to read cross-origin responses
# from a browser (see internal/cors). Leave empty (default) to allow none —
# safe until you actually have a frontend. Example for a local dev frontend:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
# For production, use the frontend's real origin(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://tamiyo.example.com
CORS_ALLOWED_ORIGINS=

# --- SMTP (outgoing mail for password-reset emails) ---
# Leave SMTP_HOST empty to skip real email sending: the reset email is
# logged to stdout instead (see internal/mail.LoggingMailer), which is
# enough for local development. Set all of these to send real emails
# (e.g. via a provider's SMTP relay, or a local Mailhog/Mailpit for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
